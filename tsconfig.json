{
  // Type checking: every .ts file, fully strict (npm run typecheck). Node runs the tools and tests directly
  // (type stripping); the browser loads tsconfig.build.json's emit of src/ from build/.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "*.ts"]
}
