{
  // Emit only: src/ (TypeScript and the JavaScript not yet converted) → build/, which index.html loads.
  // Type checking is tsconfig.json's (legacy JSDoc files) and tsconfig.strict.json's (every .ts file).
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": false,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "removeComments": false,
    "skipLibCheck": true,
    "noCheck": true,
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src/**/*.js", "src/**/*.ts"]
}
